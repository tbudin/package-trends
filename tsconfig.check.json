{
  // tsconfig.json is the build: src only, emitting declarations into types/.
  // This one checks everything else that ships or guards the package. Vitest
  // strips types without checking them, so without this a test file's types
  // are never looked at by anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "rootDir": "."
  },
  "include": ["src", "test"]
}
