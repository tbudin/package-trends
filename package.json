{
  "name": "package-trends",
  "version": "0.0.0",
  "description": "npm download trends as a sparkline, a line of text, or a KPI block. Zero dependencies, works without a proxy.",
  "keywords": [
    "npm",
    "downloads",
    "trends",
    "sparkline",
    "kpi",
    "stats",
    "badge",
    "react"
  ],
  "license": "MIT",
  "author": "Thomas Budin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./compare": {
      "types": "./types/compare-react.d.ts",
      "default": "./dist/compare-react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:package",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "changeset": "changeset",
    "bump": "changeset version",
    "prepublishOnly": "pnpm build",
    "build:docs": "node scripts/build-docs.mjs",
    "build:shots": "node scripts/build-shots.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.24.2",
    "publint": "0.2.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbudin/package-trends.git"
  },
  "homepage": "https://tbudin.github.io/package-trends/",
  "bugs": {
    "url": "https://github.com/tbudin/package-trends/issues"
  },
  "packageManager": "pnpm@9.15.0"
}
