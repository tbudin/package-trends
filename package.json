{
  "name": "package-trends",
  "version": "0.2.0",
  "description": "npm download trends as a sparkline, a calendar heatmap, a line of text, or a KPI block. Compare packages, repair npm's missing days. Zero dependencies, works without a proxy.",
  "keywords": [
    "npm",
    "downloads",
    "trends",
    "sparkline",
    "heatmap",
    "calendar-heatmap",
    "chart",
    "kpi",
    "stats",
    "badge",
    "react"
  ],
  "license": "MIT",
  "author": "Thomas Budin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./compare": {
      "types": "./types/compare-react.d.ts",
      "default": "./dist/compare-react.js"
    },
    "./heatmap": {
      "types": "./types/heatmap-react.d.ts",
      "default": "./dist/heatmap-react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src test scripts",
    "lint:package": "publint --strict",
    "lint:types": "attw --pack . --profile esm-only",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm lint:package && pnpm lint:types && pnpm check:sizes",
    "check:sizes": "node scripts/check-sizes.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "changeset": "changeset",
    "bump": "changeset version",
    "prepublishOnly": "pnpm build",
    "build:docs": "node scripts/build-logos.mjs && node scripts/build-sizes.mjs && node scripts/build-docs.mjs && package-site build",
    "build:shots": "node scripts/build-shots.mjs",
    "check:docs": "node scripts/build-logos.mjs && node scripts/build-sizes.mjs && node scripts/build-docs.mjs && package-site check && node scripts/check-reference.mjs",
    "docs": "node scripts/build-logos.mjs && node scripts/build-sizes.mjs && node scripts/build-docs.mjs && package-site serve 4322",
    "build:logos": "node scripts/build-logos.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.27.10",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.24.2",
    "oxlint": "1.90.0",
    "package-site": "github:tbudin/package-site#v0.1.0",
    "publint": "0.2.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "simple-icons": "16.36.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbudin/package-trends.git"
  },
  "homepage": "https://tbudin.github.io/package-trends/",
  "bugs": {
    "url": "https://github.com/tbudin/package-trends/issues"
  },
  "packageManager": "pnpm@9.15.0"
}
